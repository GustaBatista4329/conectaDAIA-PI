# Imagem de desenvolvimento do backend: instala dependências e roda o
# uvicorn com --reload. Não é usada em produção (ver Dockerfile na raiz,
# que faz o build multi-etapa e serve o frontend junto).
FROM python:3.12-slim
WORKDIR /app

COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

ENV PYTHONUNBUFFERED=1
CMD alembic upgrade head && uvicorn app.main:app --host 0.0.0.0 --port 8000 --reload
